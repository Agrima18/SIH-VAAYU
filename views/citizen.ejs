<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Delhi AQI Dashboard</title>

  <!-- Bootstrap + Icons + Leaflet -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://unpkg.com/leaflet/dist/leaflet.css" />
  <link rel="stylesheet" href="https://unpkg.com/leaflet-routing-machine/dist/leaflet-routing-machine.css" />
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css" />
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
  <script src="https://kit.fontawesome.com/a076d05399.js" crossorigin="anonymous"></script>

  <style>
    :root { --crimson: #DC143C; --dark: #212529; --light: #f8f9fa; }
    body { font-family: 'Poppins', sans-serif; background: var(--light); color: var(--dark); }
    h2 { text-align: center; margin: 25px 0; font-weight: 600; color: var(--crimson); }
    .card { border: none; border-radius: 16px; box-shadow: 0 4px 14px rgba(0,0,0,0.05); }
    .section-title { font-size: 1.2rem; font-weight: 600; margin-bottom: 10px; color: var(--crimson); }
    .map-container { height: 360px; border-radius: 12px; }
    .btn-crimson { background-color: var(--crimson); color: #fff; border-radius: 8px; }
    .btn-crimson:hover { background-color: #b01030; }
    .calendar-box { background: #fefefe; border-radius: 12px; padding: 15px; }
    footer { text-align: center; padding: 20px; font-size: 0.9rem; color: #777; margin-top: 20px; }
  </style>
</head>

<body>
  <!-- Header -->
  <div class="container">
    <h2><i class="fas fa-city"></i> Delhi AQI Dashboard</h2>
  </div>

  <div class="container">
    <div class="row g-4">
      
      <!-- 🌫 AQI Map -->
      <div class="col-md-6">
        <div class="card p-3">
          <div class="section-title"><i class="fas fa-smog"></i> Current AQI Map</div>
          <div id="aqiMap" class="map-container"></div>
          <p class="text-muted mt-2 mb-0"><i class="fas fa-info-circle"></i> Zoom in to see location-wise air quality markers.</p>
        </div>
      </div>

      <!-- 🚗 Route Planner -->
      <div class="col-md-6">
        <div class="card p-3">
          <div class="section-title"><i class="fas fa-route"></i> Smart Route Planner</div>
          <input type="text" id="source" class="form-control mb-2" placeholder="Enter Source (or leave blank for current location)">
          <input type="text" id="destination" class="form-control mb-3" placeholder="Enter Destination (e.g. India Gate)">
          <button id="calculateRouteBtn" class="btn btn-crimson w-100 mb-3">
            <i class="fas fa-map-marked-alt"></i> Calculate Route
          </button>
          <div id="routeMap" class="map-container"></div>
        </div>
      </div>

      <!-- 📅 AQI Calendar -->
      <div class="col-md-6">
        <div class="card p-3">
          <div class="section-title"><i class="fas fa-calendar-alt"></i> Smart AQI Calendar</div>
          <div id="smartCalendar" class="calendar-box"></div>
        </div>
      </div>

      <!-- 📊 AQI Chart -->
      <div class="col-md-6">
        <div class="card p-3">
          <div class="section-title"><i class="fas fa-chart-line"></i> AQI Trends</div>
          <canvas id="pmChart" style="height: 300px;"></canvas>
        </div>
      </div>
    </div>
  </div>

  <footer>
    🚀 Powered by Open-Meteo, OpenStreetMap, and Leaflet Routing Machine
  </footer>

  <!-- Scripts -->
  <script src="https://unpkg.com/leaflet/dist/leaflet.js"></script>
  <script src="https://unpkg.com/leaflet-routing-machine/dist/leaflet-routing-machine.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>

  <script>
    let userCoords = [28.6139, 77.2090]; // Delhi default
    let routeControl;

    // 🌫 AQI Map
    const aqiMap = L.map('aqiMap').setView(userCoords, 11);
    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png').addTo(aqiMap);

    // 🚗 Route Map
    const routeMap = L.map('routeMap').setView(userCoords, 12);
    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png').addTo(routeMap);

    // 🎯 Get User Location
    if (navigator.geolocation) {
      navigator.geolocation.getCurrentPosition(pos => {
        userCoords = [pos.coords.latitude, pos.coords.longitude];
        aqiMap.setView(userCoords, 12);
        L.marker(userCoords).addTo(aqiMap).bindPopup("📍 You are here").openPopup();
        plotAQI(userCoords[0], userCoords[1]);
      }, () => plotAQI(userCoords[0], userCoords[1]));
    } else plotAQI(userCoords[0], userCoords[1]);

    // 🌫 Fetch and display AQI
    async function plotAQI(lat, lon) {
      const res = await fetch(`https://air-quality-api.open-meteo.com/v1/air-quality?latitude=${lat}&longitude=${lon}&current=us_aqi`);
      const data = await res.json();
      const aqi = data?.current?.us_aqi || 120;
      const color = aqi <= 50 ? "green" : aqi <= 100 ? "yellow" : aqi <= 200 ? "orange" : "red";

      L.circleMarker([lat, lon], { radius: 14, color, fillColor: color, fillOpacity: 0.6 })
        .addTo(aqiMap)
        .bindPopup(`<b>AQI: ${aqi}</b>`);
    }

    // 🚗 Route Planner
    document.getElementById("calculateRouteBtn").addEventListener("click", async () => {
      const srcInput = document.getElementById("source").value.trim();
      const destInput = document.getElementById("destination").value.trim();
      if (!destInput) return alert("Please enter a destination.");

      const srcCoords = srcInput ? await geocode(srcInput) : userCoords;
      const destCoords = await geocode(destInput);
      if (!srcCoords || !destCoords) return alert("Invalid source or destination.");

      if (routeControl) routeMap.removeControl(routeControl);
      routeControl = L.Routing.control({
        waypoints: [L.latLng(srcCoords), L.latLng(destCoords)],
        routeWhileDragging: true
      }).addTo(routeMap);
    });

    async function geocode(place) {
      const res = await fetch(`https://nominatim.openstreetmap.org/search?format=json&q=${encodeURIComponent(place + ', Delhi, India')}`);
      const data = await res.json();
      if (data.length > 0) return [parseFloat(data[0].lat), parseFloat(data[0].lon)];
      return null;
    }

    // 📅 Smart Calendar with AQI Colors
    flatpickr("#smartCalendar", {
      inline: true,
      enable: ["2025-10-01", "2025-10-02", "2025-10-03"],
      onDayCreate: (dObj, dStr, fp, dayElem) => {
        const aqiSample = { "2025-10-01": 80, "2025-10-02": 180, "2025-10-03": 240 };
        const dateStr = dayElem.dateObj.toISOString().split('T')[0];
        if (aqiSample[dateStr]) {
          const aqi = aqiSample[dateStr];
          const color = aqi <= 100 ? "green" : aqi <= 200 ? "orange" : "red";
          dayElem.style.background = color; 
          dayElem.style.color = "#fff";
          dayElem.title = `AQI: ${aqi}`;
        }
      }
    });

    // 📊 AQI Chart
    const ctx = document.getElementById('pmChart').getContext('2d');
    new Chart(ctx, {
      type: 'line',
      data: {
        labels: ['Mon','Tue','Wed','Thu','Fri','Sat','Sun'],
        datasets: [{
          label: 'AQI',
          data: [90, 120, 150, 180, 110, 80, 200],
          borderColor: '#DC143C',
          tension: 0.4,
          fill: false
        }]
      },
      options: {
        responsive: true,
        plugins: { legend: { display: false } },
        scales: { y: { beginAtZero: true, title: { display: true, text: 'AQI' } } }
      }
    });
  </script>
</body>
</html>
